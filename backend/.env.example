# Defaults to the local SQLite file. For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ekavani
DATABASE_URL=sqlite:///./ekavani.db
# Set a long random value before deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WHISPER_MODEL=base
